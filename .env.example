# Copy to .env and fill in. Everything here is optional — Wheelwright needs no
# account, no token and no network.

# Python interpreter with OpenCascade (`pip install cadquery-ocp`).
# Unset, the server looks for ./bin/occ-venv (made by `npm run setup:occ`),
# then python3 / python / py -3 on PATH.
# WHEELWRIGHT_PYTHON=/absolute/path/to/python

# PORT=3000
